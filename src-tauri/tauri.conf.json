{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patina",
  "version": "0.4.5",
  "identifier": "dev.amethyst.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Patina",
        "width": 1200,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: media: http://media.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost media: http://media.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Game",
    "shortDescription": "Minimalist Minecraft launcher",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
